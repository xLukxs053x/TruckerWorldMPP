# Discord application (Developer Portal -> General Information / Bot)
DISCORD_CLIENT_ID=123456789012345678
DISCORD_BOT_TOKEN=replace-with-your-bot-token

# Not required for normal bot operation. Only set this if a separate OAuth2
# authorization-code flow is added later.
DISCORD_CLIENT_SECRET=

# Optional: during development, synchronize commands immediately to this test
# guild only. Leave empty to use global commands for every installed guild.
DISCORD_GUILD_ID=

# Existing TruckerWorldMP platform
TWMP_API_URL=https://truckerworldmp.com/api/v1
TWMP_WEB_URL=https://truckerworldmp.com
TWMP_LOGO_URL=https://truckerworldmp.com/twmp-icon.png
TWMP_PRIMARY_SERVER_SLUG=europe-1

# Bot runtime
BOT_DATABASE_PATH=data/truckerworldmp-bot.db
LOG_LEVEL=INFO
COMMAND_SYNC_ON_START=true
ENABLE_MEMBER_INTENT=true
STATUS_POLL_INTERVAL_SECONDS=60
ANNOUNCEMENT_POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10
