# Discord-Anwendung (Developer Portal -> General Information / Bot)
DISCORD_CLIENT_ID=123456789012345678
DISCORD_BOT_TOKEN=replace-with-your-bot-token

# Für den normalen Bot-Betrieb nicht erforderlich. Nur setzen, wenn später ein
# eigener OAuth2-Code-Flow im Bot ergänzt wird.
DISCORD_CLIENT_SECRET=

# Optional: Während der Entwicklung synchronisiert der Bot Commands sofort nur
# auf diesen Testserver. Leer = globale Commands für alle installierten Server.
DISCORD_GUILD_ID=

# Bestehende TruckerWorldMP-Plattform
TWMP_API_URL=https://truckerworldmp.com/api/v1
TWMP_WEB_URL=https://truckerworldmp.com
TWMP_LOGO_URL=https://truckerworldmp.com/twmp-icon.png

# Bot-Laufzeit
BOT_DATABASE_PATH=data/truckerworldmp-bot.db
LOG_LEVEL=INFO
COMMAND_SYNC_ON_START=true
ENABLE_MEMBER_INTENT=true
STATUS_POLL_INTERVAL_SECONDS=60
ANNOUNCEMENT_POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=10

